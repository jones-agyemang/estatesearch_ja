<h3>Respond to Question</h3>
<% if @response.errors.any? %>
  <%= flash[:error] %>
  <div class="errors">
    <ul>
      <% @response.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>


<%= form_with model: [@question, @response] do |form| %>
  <div>
    <%= form.label :body %>
    <%= form.text_area :body %>
  </div>
  <div>
    <%= form.label :fee %>
    <%= form.number_field :fee, step: 0.01 %>
  </div>
  <%= form.submit "Submit response" %>
<% end %>