<section class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <header class="mb-6 border-b border-slate-100 pb-6">
      <h3 class="text-2xl font-semibold text-slate-950">Respond to Question</h3>
      <p class="mt-2 text-sm text-slate-600">Write your response and set the fee for the user to approve.</p>
    </header>

    <% if @question.present? %>
      <div class="mb-6 rounded-md border border-slate-200 bg-slate-50 px-4 py-3">
        <p class="text-sm font-medium text-slate-950"><%= @question.title %></p>
        <p class="mt-1 text-sm text-slate-700"><%= @question.body %></p>
        <p class="mt-2 text-xs font-medium uppercase tracking-wide text-slate-500"><%= @question.category %></p>
      </div>
    <% end %>

    <% if @response.errors.any? %>
      <div class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <% if flash[:error].present? %>
          <p class="font-medium"><%= flash[:error] %></p>
        <% end %>

        <ul class="list-disc space-y-1 pl-5 <%= "mt-2" if flash[:error].present? %>">
          <% @response.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: [@question, @response], class: "space-y-6" do |form| %>
      <div>
        <%= form.label :body, class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area(
          :body,
          rows: 7,
          class: "mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
        ) %>
      </div>

      <div>
        <%= form.label :fee, class: "block text-sm font-medium text-slate-700" %>
        <%= form.number_field(
          :fee,
          step: 0.01,
          class: "mt-2 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 shadow-sm outline-none placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
        ) %>
      </div>

      <div class="flex justify-end border-t border-slate-100 pt-6">
        <%= form.submit(
          "Submit response",
          class: "inline-flex cursor-pointer items-center justify-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
        ) %>
      </div>
    <% end %>
  </div>
</section>
