<div>
  <p>Logged in as: <%= @user.email %></p>
</div>
<h1>Questions</h1>

<div>
  <%= link_to("Add new question", new_user_question_path(@user)) %>
</div>

<div><%= flash[:notice] %></div>
<div><%= flash[:alert] %></div>
<% if @questions.any? %>
  <% @questions.each do |question| %>
    <h2>Title: <%= question.title %><h2>
    <p>Body: <%= question.body %></p>
    <p>Category: <%= question.category %><p>
    <p>Question status: <%= question.status %><p>

    <h3>Response(s)</h3>  
    <table>
      <thead>
        <tr>
          <th>Respondent</th>
          <th>Content</th>
          <th>Response status</th>
        </tr>
      </thead>
      <tbody>
        <% question.responses.each do |response| %>
          <% if response.paid %>
            <tr>
              <td><%= response.lawyer.email %></td>
              <td><%= response.body %></td>
              <td><%= response.paid ? "Paid" : "Unpaid" %></td>
            </tr>
          <% else %>
            <td style="color: red;">Payment pending</td>
            <td>
              <%= button_to("Approve payment for GBP #{response.fee.round(2)}", approve_payment_question_response_path(question, response), method: :patch) %>
            </td>
          <% end %>
        <% end %>
      </tbody>
    </table>
    <hr>
  <% end %>
<% else %>
  <p>No questions have been submitted yet.</p>
<% end %>
