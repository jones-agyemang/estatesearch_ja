<div>
  <p>Logged in as: <%= @user.email %></p>
</div>
<h1>Questions</h1>

<div>
  <%= link_to("Add new question", new_user_question_path(@user)) %>
</div>

<div><%= flash[:notice] %></div>
<div><%= flash[:alert] %></div>
<% if @questions.any? %>
  <% @questions.each do |question| %>
    <h2>Title: <%= question.title %><h2>
    Body: <%= question.body %>
    <p>Category: <%= question.category %><p>

    <% question.responses.each do |response| %>
      <table>
        <thead>
          <tr>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <% if response.paid %>
              <td><%= response.body %></td>
              <td style="color: green;">Answered</td>
            <% else %>
              <td style="color: red;">Payment pending</td>
              <td>
                <%= button_to("Approve payment", approve_payment_question_response_path(question, response), method: :patch) %>
              </td>
            <% end %>
          <tr>
        </tbody>
      </table>

      <div>
      </div>
    <% end %>
    <hr>
  <% end %>
<% else %>
  <p>No questions have been submitted yet.</p>
<% end %>
