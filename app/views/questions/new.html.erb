<h1>Legal Advice Q&A</h1>

<%= flash[:error] %>
<ul>
  <% @question.errors.full_messages.each do |error_msg| %>
    <div>
      <li><%= error_msg %></li>
    </div>
  <% end %>
</ul>

<h3>Raise a Query</h3>
<%= form_with model: @question do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>
  <div>
    <%= form.label :body %>
    <%= form.text_area :body %>
  </div>
  <div>
    <%= form.label :category %>
    <%= form.text_field :category %>
  </div>
  <%= form.submit "Submit query" %>
<% end %>